# Live trading remains disabled until a separate, explicit activation step.
LIVE_TRADING_ENABLED=false
TRADING_QUOTE_ASSET=USDC
BINANCE_BASE_URL=https://api.binance.com
LOG_LEVEL=INFO

# Add these only on the server. Never commit real values.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Dashboard configuration. The publishable key is intended for browser use;
# database access is still protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
