# Live trading remains disabled until a separate, explicit activation step.
LIVE_TRADING_ENABLED=false
LIVE_CAP_USDC=100
LIVE_ORDER_USDC=25
LIVE_STOP_PERCENT=1
LIVE_TARGET_PERCENT=2
LIVE_DAILY_LOSS_USDC=2
LIVE_MAX_TRADES_PER_DAY=6
LIVE_COOLDOWN_SECONDS=1800
LIVE_STATE_PATH=/var/lib/ai-trading-app/live-state.json
TRADING_QUOTE_ASSET=USDC
BINANCE_BASE_URL=https://api.binance.com
LOG_LEVEL=INFO

# Add these only on the server. Never commit real values.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Dashboard configuration. The publishable key is intended for browser use;
# database access is still protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
